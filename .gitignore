# экспорт дизайн-канваса (5.7 МБ) — не в git, исходники экранов будут в design/screens
design/_export/

# окружение и инструменты
.env
# временные файлы ./task setup и scripts/env-keys.sh — с настоящими ключами
.env.tmp*
.tools/
.task/
node_modules/

# сборки фронтов
.next/
dist/
# витрина Ladle (`ladle build`, apps/admin/.ladle/config.mjs) и админка режима shots (`vite build --mode shots`)
dist-stories/
dist-shots/
# визуальные тесты (apps/admin/visual): эталон из артефакта, снимки прогона, отчёты — не в репозитории
apps/admin/visual/.baseline/
apps/admin/visual/.out/
apps/admin/visual/report/
apps/admin/visual/results.json
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.env.local
.env.*.local

# бинарники `go build ./cmd/<имя>` из backend/ (Windows — .exe, Linux/macOS — без расширения);
# `go build ./cmd/...` (несколько пакетов) ничего не пишет
/backend/*.exe
/backend/api
/backend/admin-api
/backend/worker
/backend/migrate
/backend/permdoc
