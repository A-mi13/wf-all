root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# выдержки данных: пустые последние колонки TSV — это хвостовые TAB
[**/testdata/**]
trim_trailing_whitespace = false
