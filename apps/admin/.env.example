# Админка ходит в API только с того же origin (спека сотрудников §5.2): /v1/* в dev проксирует Vite,
# в проде статику и API отдаёт сам admin-api. Отдельного адреса API у сборки нет.
# Куда dev-сервер Vite проксирует /v1/* — адрес admin-api (ADMIN_HTTP_ADDR в backend/.env).
# Серверная переменная (без VITE_), в браузер не попадает
WF_ADMIN_API_ORIGIN=http://127.0.0.1:8081
