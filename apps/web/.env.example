# Куда Next проксирует /v1/* (серверная переменная, в браузер не попадает)
WF_API_ORIGIN=http://127.0.0.1:8080

# Порт сервера для e2e (`pnpm e2e`, Playwright): читается из окружения процесса, а не из .env.local;
# по умолчанию 3000. Локально Playwright переиспользует любой сервер на порту — если :3000 занят чужим
# приложением, задайте другой порт: WF_WEB_PORT=3100 pnpm e2e
# WF_WEB_PORT=3000
