# скопировать в backend/.env. Только dev: пароли совпадают с deploy/dev/initdb.
# Порт 15432 в URL — WF_PG_PORT из deploy/dev/.env: сменил там — поменяй и здесь
API_HTTP_ADDR=127.0.0.1:8080
API_DATABASE_URL=postgres://api:api@localhost:15432/wf?sslmode=disable
API_LOG_FORMAT=text
# Swagger UI на http://127.0.0.1:8080/docs
API_DOCS_ENABLED=true
# Крайний срок запроса (по умолчанию 15s)
# API_REQUEST_TIMEOUT=15s
# Сиды Ed25519 access-токенов (base64, 32 байта) через запятую: первый подписывает, все проверяют.
# Сгенерировать: openssl rand -base64 32
API_JWT_SEEDS=<base64-32-байта>
# Ключи HMAC задач антибота (PoW по протоколу ALTCHA), base64 ≥ 32 байт, через запятую
API_HUMANCHECK_KEYS=<base64-32-байта>
# Срок задачи (≥ 1s) и сложность перебора (1…2^53-1), по умолчанию 5m и 100000
# API_HUMANCHECK_TTL=5m
# API_HUMANCHECK_MAX_NUMBER=100000
# Прокси, которым верим X-Forwarded-For и заголовку CDN (CIDR через запятую); локально прокси нет.
# На стенде Render (render.yaml) — петля и частные сети: 127.0.0.0/8,::1/128,10.0.0.0/8,...
# Через запятую без висячей запятой: пустой элемент — отказ старта
API_TRUSTED_PROXIES=
# Заголовок CDN с адресом посетителя (CF-Connecting-IP у Cloudflare), читается только от
# API_TRUSTED_PROXIES и важнее X-Forwarded-For; задан без прокси — отказ старта. Локально CDN нет — пусто
API_CLIENT_IP_HEADER=
# BFF (Next.js): адреса и общий секрет (≥ 32 символов) — от него API принимает X-WF-Client-IP.
# Пока веб в API не ходит (до спеки веба) — пусто; со спекой веба: адреса BFF (127.0.0.1/32
# локально) и секрет из openssl rand -base64 32, тот же — в apps/web/.env.local.
# Адреса — через запятую без висячей запятой: пустой элемент — отказ старта
API_BFF_NETS=
API_BFF_SECRETS=
# Переопределения лимитов: <класс>.<ip|user|device>=<лимит>/<период>[:<всплеск>] или =off
# Класс — из ratelimit.DefaultRules или x-rate-limit контракта; другой (опечатка) — отказ старта
API_RATE_LIMITS=
# Identity (спека identity §11.3). Кольцо секретов: коды из писем, TOTP, данные регистрации — base64 ≥ 32 байт через
# запятую, первый шифрует. То же значение — в WORKER_IDENTITY_SECRET_KEYS (письма с кодами собирает воркер).
# Ротация: новый ключ первым → api identity rekey → старый убрать не раньше 7 дней и только когда под ним
# не осталось резервных кодов 2FA (docs/deploy-dev.md).
# Сгенерировать: openssl rand -base64 32
API_IDENTITY_SECRET_KEYS=<base64-32-байта>
# Кольцо HMAC устройств (install_id), base64 ≥ 32 байт через запятую
API_IDENTITY_DEVICE_KEYS=<base64-32-байта>
# Имя в приложении-аутентификаторе (TOTP); бренд не финален — только здесь и в окружении стенда
API_IDENTITY_TOTP_ISSUER=WF dev
# Город по IP: путь к MMDB DB-IP «IP to City Lite» (файл не в репозитории); пусто — город по IP не определяется
API_IPGEO_DB=
# Текущие версии и ссылки документов: terms=<версия>|<url>,privacy=<версия>|<url>; пусто — отказ старта.
# Значение в кавычках: в нём | и ,
API_LEGAL_DOCUMENTS="terms=0.1.0|https://example.com/legal/terms,privacy=0.1.0|https://example.com/legal/privacy"
# /.well-known до веба: <TEAMID>.<bundle id> через запятую (apple-app-site-association) и
# <package>=<SHA-256 сертификата>[;…] (assetlinks.json); пусто — 404
API_WELLKNOWN_APPLE_APP_IDS=
API_WELLKNOWN_ANDROID=
# Воркер в процессе api (только dev-стенд без отдельного процесса; прод — отдельный worker): true — api читает
# WORKER_* ниже (второй пул под ролью worker, WORKER_IDENTITY_SECRET_KEYS = API_IDENTITY_SECRET_KEYS); локально — false
API_EMBED_WORKER=false

ADMIN_HTTP_ADDR=127.0.0.1:8081
ADMIN_DATABASE_URL=postgres://admin:admin@localhost:15432/wf?sslmode=disable
ADMIN_LOG_FORMAT=text
# Сколько ждать при старте, пока версия схемы не дорастёт до вшитой (миграции накатывает только wf-api / cmd/migrate):
# порт до этого не слушается; не дождался — код выхода 1. Команды оператора не ждут. По умолчанию 10m
ADMIN_DB_SCHEMA_WAIT=10m
ADMIN_DOCS_ENABLED=true
# Прокси, которым верим X-Forwarded-For (CIDR через запятую); локально прокси нет.
# Через запятую без висячей запятой: пустой элемент — отказ старта
ADMIN_TRUSTED_PROXIES=
# Заголовок CDN с адресом посетителя — как API_CLIENT_IP_HEADER; локально CDN нет — пусто
ADMIN_CLIENT_IP_HEADER=
# Переопределения лимитов — в формате API_RATE_LIMITS
ADMIN_RATE_LIMITS=
# Origin админки (схема://хост:порт, без пути): проверка CSRF (Origin запроса) и ссылки в письмах.
# В dev — адрес Vite: он отдаёт админку и проксирует /v1 в admin-api
ADMIN_ORIGIN=http://127.0.0.1:5173
# Кольцо ключей секретов сотрудников (TOTP, коды приглашений, резервные коды), base64 ≥ 32 байт через
# запятую: первый шифрует, остальные только расшифровывают. Ротация: новый ключ первым,
# admin-api staff rekey, затем старый убрать. Сгенерировать: openssl rand -base64 32
ADMIN_STAFF_SECRET_KEYS=<base64-32-байта>
# Сети, из которых пускают в админку (CIDR через запятую без висячей запятой); пусто — выключено
ADMIN_IP_ALLOWLIST=
# Cookie сессии __Host-wf_admin_session с Secure. false — только dev по http, если браузер не принял
# __Host- на 127.0.0.1 (тогда имя wf_admin_session); в проде — только true. true при http-origin — только на
# 127.0.0.1, [::1] или localhost (иначе отказ старта: Secure-cookie по http браузер не примет)
ADMIN_COOKIE_SECURE=true
# Каталог собранной админки (apps/admin/dist): admin-api отдаёт её с того же origin. В dev — пусто:
# статику отдаёт Vite
ADMIN_STATIC_DIR=
# Почта сотрудникам (приглашения, сброс доступа, блокировка) отправляет admin-api; в dev — Mailpit
# (./task mail, UI http://127.0.0.1:18025); в проде — SMTP провайдера с TLS
ADMIN_MAIL_SMTP_ADDR=127.0.0.1:11025
ADMIN_MAIL_FROM=WhereFootball <noreply@wherefootball.local>
ADMIN_MAIL_SMTP_TLS=none
# ADMIN_MAIL_SMTP_USERNAME=
# ADMIN_MAIL_SMTP_PASSWORD=
# Побудка wf-api после успешных мутаций (только dev-стенд, где фон спит вместе с api): https://<хост> без пути;
# пусто — выключено (локально и в проде)
ADMIN_WAKE_API_URL=

WORKER_DATABASE_URL=postgres://worker:worker@localhost:15432/wf?sslmode=disable
WORKER_LOG_FORMAT=text
# Ожидание схемы при старте — как ADMIN_DB_SCHEMA_WAIT; разовые команды (events replay, geo import) не ждут
WORKER_DB_SCHEMA_WAIT=10m
# Конкурентность очередей (спека §9.1), каждая ≥ 1 (проверка до базы). В сумме по умолчанию 29 — больше WORKER_DB_MAX_CONNS (10):
# задачи ждут соединения из пула; поднимаешь очереди — поднимай и WORKER_DB_MAX_CONNS
WORKER_QUEUE_EVENTS=10
WORKER_QUEUE_LIFECYCLE=5
WORKER_QUEUE_NOTIFY=5
WORKER_QUEUE_MAIL=2
WORKER_QUEUE_STATS=2
WORKER_QUEUE_MEDIA=2
WORKER_QUEUE_MAINTENANCE=2
# Импорт GeoNames (geo.import, до 30 мин на задачу) — своя очередь, не держит слоты maintenance
WORKER_QUEUE_IMPORT=1
# Обслуживать ли очередь import: false — задачи geo.import ждут в очереди (стенд Render free), WORKER_QUEUE_IMPORT
# тогда не проверяется; разовая команда geo import от флага не зависит
WORKER_GEO_IMPORT_ENABLED=true
# Раскладка событий: пачка и страховочный опрос, если NOTIFY потерялся
WORKER_RELAY_BATCH=100
WORKER_RELAY_POLL=5s
# Источник городов для импорта geo (worker geo import --country RU, задача geo.import): только
# https; лимиты — байты на скачиваемый файл (50 МБ) и на распакованную запись zip (200 МБ)
WORKER_GEONAMES_BASE_URL=https://download.geonames.org
WORKER_GEONAMES_MAX_COMPRESSED=52428800
WORKER_GEONAMES_MAX_UNCOMPRESSED=209715200
# Дополнительный корень TLS источника — путь к PEM (HTTPS-фикстура живого e2e, зеркало с собственным CA); пусто —
# только системные корни. Битый файл — воркер не стартует
WORKER_GEONAMES_CA_FILE=
# Кольцо секретов identity — то же значение, что API_IDENTITY_SECRET_KEYS (воркер расшифровывает адреса и коды писем).
# Обязательно воркеру; разовым командам (events replay, geo import) не нужно
WORKER_IDENTITY_SECRET_KEYS=<base64-32-байта>
# Почта: Mailpit (./task mail, UI http://127.0.0.1:18025); в проде — SMTP провайдера с TLS
# Обязательна воркеру; разовым командам (events replay, geo import) не нужна
WORKER_MAIL_SMTP_ADDR=127.0.0.1:11025
WORKER_MAIL_FROM=WhereFootball <noreply@wherefootball.local>
WORKER_MAIL_SMTP_TLS=none
# WORKER_MAIL_SMTP_USERNAME=
# WORKER_MAIL_SMTP_PASSWORD=

MIGRATOR_DATABASE_URL=postgres://migrator:migrator@localhost:15432/wf?sslmode=disable
MIGRATOR_LOG_FORMAT=text
