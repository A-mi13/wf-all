# скопировать в backend/.env. Только dev: пароли совпадают с deploy/dev/initdb.
# Порт 15432 в URL — WF_PG_PORT из deploy/dev/.env: сменил там — поменяй и здесь
API_HTTP_ADDR=127.0.0.1:8080
API_DATABASE_URL=postgres://api:api@localhost:15432/wf?sslmode=disable
API_LOG_FORMAT=text
# Swagger UI на http://127.0.0.1:8080/docs
API_DOCS_ENABLED=true
# Крайний срок запроса (по умолчанию 15s)
# API_REQUEST_TIMEOUT=15s
# Сиды Ed25519 access-токенов (base64, 32 байта) через запятую: первый подписывает, все проверяют.
# Сгенерировать: openssl rand -base64 32
API_JWT_SEEDS=<base64-32-байта>
# Ключи HMAC задач антибота (PoW по протоколу ALTCHA), base64 ≥ 32 байт, через запятую
API_HUMANCHECK_KEYS=<base64-32-байта>
# Срок задачи (≥ 1s) и сложность перебора (1…2^53-1), по умолчанию 5m и 100000
# API_HUMANCHECK_TTL=5m
# API_HUMANCHECK_MAX_NUMBER=100000
# Прокси, которым верим X-Forwarded-For и заголовку CDN (CIDR через запятую); локально прокси нет.
# На стенде Render (render.yaml) — петля и частные сети: 127.0.0.0/8,::1/128,10.0.0.0/8,...
# Через запятую без висячей запятой: пустой элемент — отказ старта
API_TRUSTED_PROXIES=
# Заголовок CDN с адресом посетителя (CF-Connecting-IP у Cloudflare), читается только от
# API_TRUSTED_PROXIES и важнее X-Forwarded-For; задан без прокси — отказ старта. Локально CDN нет — пусто
API_CLIENT_IP_HEADER=
# BFF (Next.js): адреса и общий секрет (≥ 32 символов) — от него API принимает X-WF-Client-IP.
# Пока веб в API не ходит (до спеки веба) — пусто; со спекой веба: адреса BFF (127.0.0.1/32
# локально) и секрет из openssl rand -base64 32, тот же — в apps/web/.env.local.
# Адреса — через запятую без висячей запятой: пустой элемент — отказ старта
API_BFF_NETS=
API_BFF_SECRETS=
# Переопределения лимитов: <класс>.<ip|user|device>=<лимит>/<период>[:<всплеск>] или =off
# Класс — из ratelimit.DefaultRules или x-rate-limit контракта; другой (опечатка) — отказ старта
API_RATE_LIMITS=

ADMIN_HTTP_ADDR=127.0.0.1:8081
ADMIN_DATABASE_URL=postgres://admin:admin@localhost:15432/wf?sslmode=disable
ADMIN_LOG_FORMAT=text
ADMIN_DOCS_ENABLED=true
# Прокси, которым верим X-Forwarded-For (CIDR через запятую); локально прокси нет.
# Через запятую без висячей запятой: пустой элемент — отказ старта
ADMIN_TRUSTED_PROXIES=
# Заголовок CDN с адресом посетителя — как API_CLIENT_IP_HEADER; локально CDN нет — пусто
ADMIN_CLIENT_IP_HEADER=
# Переопределения лимитов — в формате API_RATE_LIMITS
ADMIN_RATE_LIMITS=

WORKER_DATABASE_URL=postgres://worker:worker@localhost:15432/wf?sslmode=disable
WORKER_LOG_FORMAT=text
# Конкурентность очередей (спека §9.1). В сумме по умолчанию 28 — больше WORKER_DB_MAX_CONNS (10):
# задачи ждут соединения из пула; поднимаешь очереди — поднимай и WORKER_DB_MAX_CONNS
WORKER_QUEUE_EVENTS=10
WORKER_QUEUE_LIFECYCLE=5
WORKER_QUEUE_NOTIFY=5
WORKER_QUEUE_MAIL=2
WORKER_QUEUE_STATS=2
WORKER_QUEUE_MEDIA=2
WORKER_QUEUE_MAINTENANCE=2
# Раскладка событий: пачка и страховочный опрос, если NOTIFY потерялся
WORKER_RELAY_BATCH=100
WORKER_RELAY_POLL=5s
# Почта: Mailpit (./task mail, UI http://127.0.0.1:18025); в проде — SMTP провайдера с TLS
# Обязательна воркеру; разовой команде worker events replay не нужна
WORKER_MAIL_SMTP_ADDR=127.0.0.1:11025
WORKER_MAIL_FROM=WhereFootball <noreply@wherefootball.local>
WORKER_MAIL_SMTP_TLS=none
# WORKER_MAIL_SMTP_USERNAME=
# WORKER_MAIL_SMTP_PASSWORD=

MIGRATOR_DATABASE_URL=postgres://migrator:migrator@localhost:15432/wf?sslmode=disable
MIGRATOR_LOG_FORMAT=text
