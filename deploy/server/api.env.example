# cmd/api (сервис api): публичный API. Скопировать в api.env (под .gitignore), заполнить; ключи —
# openssl rand -base64 32. Описание ключей — backend/.env.example.
# API_EMBED_WORKER здесь не задаётся: compose.yaml ставит его в "false" явно — встроенный воркер в проде запрещён (README).

# Порт внутри сети compose: Caddy проксирует на api:8080, healthcheck — /healthz на нём же
API_HTTP_ADDR=0.0.0.0:8080
API_LOG_FORMAT=json
API_DOCS_ENABLED=false
# Прямое подключение под ролью api (не pooler Neon)
API_DATABASE_URL=postgres://api:<пароль>@<хост>/wf?sslmode=require

# Кольца: через запятую, первый — текущий (ротация — .claude/rules/env.md)
API_JWT_SEEDS=<base64-32-байта>
API_HUMANCHECK_KEYS=<base64-32-байта>
# Кольцо identity — ОДНО значение с WORKER_IDENTITY_SECRET_KEYS в worker.env (письма с кодами собирает воркер)
API_IDENTITY_SECRET_KEYS=<base64-32-байта>
API_IDENTITY_DEVICE_KEYS=<base64-32-байта>
API_IDENTITY_TOTP_ISSUER=<имя-в-аутентификаторе>
API_LEGAL_DOCUMENTS="terms=<версия>|https://<домен>/legal/terms,privacy=<версия>|https://<домен>/legal/privacy"

# Клиентский IP: X-Forwarded-For ставит Caddy — верим только подсети сети wf (compose.yaml, networks.wf).
# С CDN впереди: trusted_proxies в Caddyfile и заголовок CDN здесь (CF-Connecting-IP у Cloudflare) — README
API_TRUSTED_PROXIES=172.29.0.0/24
API_CLIENT_IP_HEADER=
