# cmd/worker (сервис worker): River, relay outbox, периодика. Скопировать в worker.env (под .gitignore), заполнить.
# Описание ключей — backend/.env.example.

WORKER_LOG_FORMAT=json
# Прямое подключение под ролью worker (не pooler Neon): relay и River держат LISTEN
WORKER_DATABASE_URL=postgres://worker:<пароль>@<хост>/wf?sslmode=require
# Пул: слоты очередей по умолчанию — 29 (WORKER_QUEUE_*: 10+5+5+2+2+2+2+1) + запас 3 (queue.PoolReserve) = 32;
# меньше — WARN «слотов очередей River больше…» на каждом старте и задачи ждут соединения. LISTEN relay и River —
# ещё 2 соединения вне пула. Сумма пулов всех сервисов (api, admin-api, worker, migrate) + LISTEN — не больше
# max_connections базы (у Neon зависит от размера вычислителя); не влезает — уменьшить WORKER_QUEUE_* и пул вместе.
WORKER_DB_MAX_CONNS=32
# Кольцо identity — ОДНО значение с API_IDENTITY_SECRET_KEYS в api.env (коды в письмах)
WORKER_IDENTITY_SECRET_KEYS=<base64-32-байта>

# Письма игрокам — SMTP провайдера, только TLS
WORKER_MAIL_SMTP_ADDR=<smtp-хост>:<порт>
WORKER_MAIL_FROM="WhereFootball <noreply@<домен>>"
WORKER_MAIL_SMTP_TLS=mandatory
WORKER_MAIL_SMTP_USERNAME=<логин-smtp>
WORKER_MAIL_SMTP_PASSWORD=<пароль-smtp>

# Импорт городов GeoNames из админки (очередь import): на сервере включён
WORKER_GEO_IMPORT_ENABLED=true
WORKER_QUEUE_IMPORT=1

# Хранилище файлов (спека media §6.4, §6.5) — S3-совместимое (Garage). fs в прод-образе запрещён (WF_BUILD_KIND=prod
# в backend/Dockerfile), none — только стенд без хранилища. Ключ доступа — свой у процесса, права по бакетам — README
WORKER_BLOB_BACKEND=s3
# Внутренний адрес — сервис storage в сети compose (S3-порт storage/garage.toml); внешний — адрес хранилища
# WF_STORAGE_DOMAIN из .env compose, для подписанных ссылок (подпись SigV4 включает хост)
WORKER_BLOB_S3_ENDPOINT=http://storage:3900
WORKER_BLOB_S3_PUBLIC_ENDPOINT=https://<домен-хранилища>
WORKER_BLOB_S3_REGION=garage
WORKER_BLOB_S3_BUCKET_IN=wf-in
WORKER_BLOB_S3_BUCKET_PUB=wf-pub
WORKER_BLOB_S3_BUCKET_PRIV=wf-priv
# Ключ процесса генерирует оператор (README, «Хранилище файлов»): ID — GK$(openssl rand -hex 12), секрет —
# openssl rand -hex 32; storage-init импортирует его в Garage с правами процесса. Имена бакетов не менять: они зашиты
# в Caddyfile и storage/init.sh
WORKER_BLOB_S3_ACCESS_KEY=<ключ-доступа-worker>
WORKER_BLOB_S3_SECRET_KEY=<секрет-ключа-worker>
# Публичные варианты — домен медиа WF_MEDIA_DOMAIN (Caddy → сайт бакета wf-pub в Garage), с завершающим «/»
WORKER_MEDIA_PUBLIC_BASE_URL=https://<домен-медиа>/
# Очередь media (обработка картинок): пик памяти до ≈ 0,6 ГиБ на исполнителя у JPEG 40 Мп, до ≈ 0,9 ГиБ у PNG 16 бит
# Adam7 (худший вход; двое разом ≈ 1,84 ГиБ) — воркеру нужно ≥ 2,5 ГиБ при WORKER_QUEUE_MEDIA=2 (перепроверка
# финального ревью, 27.11); меньше памяти — WORKER_QUEUE_MEDIA=1 (README, «Память воркера»)
WORKER_QUEUE_MEDIA=2
