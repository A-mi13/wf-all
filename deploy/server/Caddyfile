# Caddy перед api и admin-api (спека 2026-11-16-embedded-worker §5): TLS автоматически (ACME), маршрут — по домену.
# Домены и почта ACME — переменные compose (.env рядом с compose.yaml).
#
# Клиентский IP: Caddy без trusted_proxies ставит в X-Forwarded-For адрес своего пира (присланный клиентом заголовок
# не продлевает) — api и admin-api верят ему только от подсети сети wf (API_TRUSTED_PROXIES, ADMIN_TRUSTED_PROXIES),
# *_CLIENT_IP_HEADER пусто. С CDN впереди — trusted_proxies в блоке servers ниже (сети CDN) и *_CLIENT_IP_HEADER
# у сервисов (README, «Клиентский IP»).
{
	email {$WF_ACME_EMAIL}
	# Только проверка в CI и локально (compose.ci.yaml): local_certs — сертификаты своего CA вместо ACME.
	# На сервере переменная не задаётся — строка пустая.
	{$WF_CADDY_CI_GLOBAL}
}

{$WF_API_DOMAIN} {
	reverse_proxy api:8080
}

{$WF_ADMIN_DOMAIN} {
	reverse_proxy admin-api:8081
}

# Хранилище файлов (спека media §6.5, план R5). Имена бакетов wf-in, wf-pub, wf-priv зашиты здесь, в storage/init.sh и
# шаблонах *.env.example; порты и root_domain сайта — storage/garage.toml (стражи server_compose_test.go сверяют).
#
# Домен медиа (*_MEDIA_PUBLIC_BASE_URL; может стоять за CDN): только чтение публичного бакета wf-pub через сайт
# Garage — GET/HEAD, Host сайта бакета. Корень и пути входящих и закрытых — 404 любым методом, прочие методы — 405.
# Cache-Control и Content-Type — метаданные объекта (их пишет воркер), Garage отдаёт их сам; nosniff он не ставит.
{$WF_MEDIA_DOMAIN} {
	header X-Content-Type-Options nosniff

	@hidden path / /wf-in /wf-in/* /wf-priv /wf-priv/*
	handle @hidden {
		respond 404
	}

	@read {
		method GET HEAD
		not path / /wf-in /wf-in/* /wf-priv /wf-priv/*
	}
	handle @read {
		reverse_proxy http://storage:3902 {
			header_up Host wf-pub.web.storage
		}
	}

	handle {
		respond 405
	}
}

# Адрес хранилища (*_BLOB_S3_PUBLIC_ENDPOINT; без CDN): подписанная загрузка POST в wf-in (и предзапрос CORS) и
# подписанное чтение GET/HEAD из wf-priv. Подпись SigV4 включает Host и путь — Caddy их не меняет (апстрим по
# http://: Caddy 2.11 подменяет Host только у HTTPS-апстрима). Листинг, прочие пути и методы — 404.
{$WF_STORAGE_DOMAIN} {
	@upload {
		path /wf-in
		method POST OPTIONS
	}
	handle @upload {
		reverse_proxy http://storage:3900
	}

	@private {
		path /wf-priv/*
		method GET HEAD
		query X-Amz-Signature=*
	}
	handle @private {
		reverse_proxy http://storage:3900
	}

	handle {
		respond 404
	}
}
