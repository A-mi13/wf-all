# Переменные уровня compose (подстановка в compose.yaml): скопировать в .env рядом с compose.yaml.
# Секретов здесь нет; переменные бинарников — в <сервис>.env (шаблоны <сервис>.env.example).

# Образ бэкенда с тегом релиза из реестра — тот же коммит, что на стенде при переходе (README)
WF_IMAGE=<реестр>/wf-backend:<тег-релиза>
# Домены: DNS-записи A/AAAA — на сервер; Caddy получает сертификаты сам (порты 80 и 443 открыты)
WF_API_DOMAIN=api.<домен>
WF_ADMIN_DOMAIN=admin.<домен>
# Почта для учётки ACME (уведомления об истечении сертификатов)
WF_ACME_EMAIL=<почта-оператора>
# Порты публикации Caddy на хосте; на сервере — 80/443 (по умолчанию), другие — только для локальной проверки
# WF_HTTP_PORT=80
# WF_HTTPS_PORT=443
