# Хранилище файлов (сервисы storage и storage-init в compose.yaml): секреты Garage. Скопировать в storage.env
# (под .gitignore), заполнить. Процессам бэкенда эти значения не нужны.

# Секрет RPC узлов Garage — openssl rand -hex 32 (один узел, но без секрета Garage не стартует)
GARAGE_RPC_SECRET=<hex-32-байта>
# Токен admin API (бакеты, ключи, права — только storage-init, только в сети wf) — openssl rand -base64 32
GARAGE_ADMIN_TOKEN=<base64-32-байта>
