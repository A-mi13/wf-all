# cmd/admin-api (сервис admin-api): API сотрудников и собранная админка с одного origin. Скопировать в admin-api.env
# (под .gitignore), заполнить. Описание ключей — backend/.env.example.
# ADMIN_WAKE_API_URL не задаётся: api на сервере не засыпает, будить нечего (только стенд Render).

# Порт внутри сети compose: Caddy проксирует на admin-api:8081, healthcheck — /healthz на нём же
ADMIN_HTTP_ADDR=0.0.0.0:8081
ADMIN_LOG_FORMAT=json
ADMIN_DOCS_ENABLED=false
# Прямое подключение под ролью admin (не pooler Neon)
ADMIN_DATABASE_URL=postgres://admin:<пароль>@<хост>/wf?sslmode=require
# Origin админки — домен WF_ADMIN_DOMAIN из .env compose: CSRF и ссылки в письмах
ADMIN_ORIGIN=https://<admin-домен>
ADMIN_COOKIE_SECURE=true
# собранная админка в образе (backend/Dockerfile)
ADMIN_STATIC_DIR=/app/admin
# Кольцо ключей сотрудников — base64url ≥ 32 байт, первый — текущий; ротация — admin-api staff rekey
ADMIN_STAFF_SECRET_KEYS=<base64-32-байта>

# Письма сотрудникам — SMTP провайдера, только TLS
ADMIN_MAIL_SMTP_ADDR=<smtp-хост>:<порт>
ADMIN_MAIL_FROM="WhereFootball <noreply@<домен>>"
ADMIN_MAIL_SMTP_TLS=mandatory
ADMIN_MAIL_SMTP_USERNAME=<логин-smtp>
ADMIN_MAIL_SMTP_PASSWORD=<пароль-smtp>

# Клиентский IP — как в api.env: X-Forwarded-For от Caddy из подсети сети wf; с CDN — README
ADMIN_TRUSTED_PROXIES=172.29.0.0/24
ADMIN_CLIENT_IP_HEADER=
